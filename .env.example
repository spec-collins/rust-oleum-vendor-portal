# Neon pooled connection string (…-pooler… preferred on Vercel)
DATABASE_URL=postgres://USER:PASS@HOST/DB?sslmode=require

# Required in production before vendor emails go out. Do not rotate after send.
LINK_SIGNING_SECRET=

# Admin UI / admin API gate
ADMIN_TOKEN=

# Public site origin used by npm run links
BASE_URL=http://localhost:3000

# Optional salt for hashed IPs in response_events
IP_HASH_SALT=

PORT=3000
